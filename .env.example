APP_NAME=Resume Processing API
API_VERSION=v1

# Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=resumes

# Optional local template paths used during formatting
# Use absolute paths in your dev machine or deployment environment.
RESUME_GUIDELINES_PATH=/absolute/path/to/utils/Formatting Guidelines.docx
RESUME_LETTERHEAD_PATH=/absolute/path/to/utils/Syntax Talent - Resume Letterhead Format Example.docx
